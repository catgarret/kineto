{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dongri.me/schemas/kineto.features.schema.json",
  "title": "Kineto feature and behavior contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "behaviorContractVersion",
    "libraryVersion",
    "moduleCount",
    "modules",
    "coreProperties",
    "coreApi",
    "compatibilityApi",
    "additionalNamedExports",
    "entryPoints",
    "criticalBehaviors"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "contractVersion": { "type": "string" },
    "behaviorContractVersion": { "type": "string" },
    "libraryVersion": { "type": "string" },
    "moduleCount": { "type": "integer", "minimum": 1 },
    "modules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "attribute", "defaultVariant", "variants", "publicOptions"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*$" },
          "attribute": { "type": "string", "pattern": "^data-kt-[a-z0-9-]+$" },
          "defaultVariant": { "type": "string", "minLength": 1 },
          "variants": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "publicOptions": {
            "type": "array",
            "items": { "type": "string", "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$" }
          }
        }
      }
    },
    "coreProperties": { "type": "array", "items": { "type": "string" } },
    "coreApi": { "type": "array", "items": { "type": "string" } },
    "compatibilityApi": { "type": "array", "items": { "type": "string" } },
    "additionalNamedExports": { "type": "array", "items": { "type": "string" } },
    "entryPoints": {
      "description": "Public package subpaths (package.json#exports minus ./style.css and ./package.json) and what each registers. package.json and the type files are checked against it.",
      "type": "object",
      "propertyNames": { "pattern": "^\\.(/[a-z*]+)*$" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["runtime", "types", "summary"],
        "properties": {
          "runtime": { "enum": ["full", "on-demand", "core", "module", "addon", "adapter"] },
          "types": { "type": "string", "pattern": "^[a-z]+$" },
          "summary": { "type": "string", "minLength": 1 },
          "api": { "description": "Methods this entry adds to Kineto on top of coreApi.", "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "deprecated": {
            "type": "object",
            "additionalProperties": false,
            "required": ["since", "becomes", "changesIn", "replacements"],
            "properties": {
              "since": { "type": "string" },
              "becomes": { "type": "string" },
              "changesIn": { "type": "string" },
              "replacements": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
            }
          }
        }
      }
    },
    "criticalBehaviors": { "type": "object" }
  }
}
