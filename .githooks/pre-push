#!/bin/sh
# Kineto pre-push check (opt-in): `npm run hooks:install` sets
# `git config core.hooksPath .githooks` for this clone only.
#
# Before a branch is pushed it runs `npm run verify:push -- --fast`
# (lint, build + generated files, every Node test — about 2–3 minutes), so a
# commit that CI would reject never leaves the machine.
#
#   Skip once:   git push --no-verify        (or KT_SKIP_VERIFY_PUSH=1 git push)
#   Uninstall:   git config --unset core.hooksPath
#
# Pushing only tags (release:ship pushes main first, then the tag) is not
# re-checked: the commit under the tag was checked when main was pushed.
[ "${KT_SKIP_VERIFY_PUSH:-}" = "1" ] && exit 0

branches=0
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/tags/*) ;;
    *) [ "$local_sha" = "0000000000000000000000000000000000000000" ] || branches=1 ;;
  esac
done
[ "$branches" = "1" ] || exit 0

echo "pre-push: npm run verify:push -- --fast (skip once with git push --no-verify)"
exec npm run --silent verify:push -- --fast
